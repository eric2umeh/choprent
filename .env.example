# Supabase — Project Settings → API (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only — never commit; add on Vercel as encrypted env (Sprint 1+ server actions)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL — local dev
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Sprint 7 — arrears reminders cron (Vercel Cron or manual curl)
# CRON_SECRET=generate-a-long-random-string

# Sprint 7 — email reminders (optional; logs to console in dev without key)
# RESEND_API_KEY=re_xxxxxxxx
# Dev/test sender (Resend): ChopRent <onboarding@resend.dev> — can only email YOUR signup address
# RESEND_FROM_EMAIL=ChopRent <onboarding@resend.dev>

# Marketing site contact (homepage footer)
NEXT_PUBLIC_CONTACT_EMAIL=choprent.tech@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=+2348180329799

# Sprint 8 — Paystack DVA (disabled until you opt in; requires business verification with Paystack)
# ENABLE_PAYSTACK_DVA=false
# PAYSTACK_SECRET_KEY=sk_live_xxxxxxxx
# PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxx
# Webhook URL: https://YOUR_DOMAIN/api/webhooks/paystack
